<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QuestHandbook</RootNamespace>
    <Title>Quest Handbook</Title>
    <Authors>kee</Authors>
    <AssemblyName>QuestHandbook-Server</AssemblyName>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
  </PropertyGroup>

  <!-- Deploy to release folder only - NEVER to the game directory -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="set &quot;dest=$(ProjectDir)..\release\SPT_Runtime\user\mods\QuestHandbook&quot;&#xD;&#xA;if not exist &quot;%25dest%25\&quot; mkdir &quot;%25dest%25\&quot;&#xD;&#xA;copy /Y &quot;$(TargetPath)&quot; &quot;%25dest%25\$(TargetFileName)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
  </ItemGroup>

</Project>
